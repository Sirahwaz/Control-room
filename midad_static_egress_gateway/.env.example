VIABTC_API_BASE_URL=https://pool.viabtc.com
VIABTC_API_KEY=REPLACE_WITH_READ_ONLY_API_KEY
MIDAD_VIABTC_GATEWAY_KEY=REPLACE_WITH_A_LONG_RANDOM_GATEWAY_TOKEN

HOST=127.0.0.1
PORT=8788
REQUEST_TIMEOUT_MS=8000

# Optional no-card bridge: route ViaBTC through a fixed/static proxy IP.
# Keep empty when using a real VPS/static-egress host directly.
MIDAD_VIABTC_PROXY_URL=
# Fail closed when enabled; never silently fall back to the host's own egress IP.
MIDAD_VIABTC_PROXY_REQUIRED=false
