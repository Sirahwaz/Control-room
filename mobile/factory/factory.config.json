{
  "$schema": "./factory.config.schema.json",
  "factory_version": 3,
  "engine": "midad-mobile-factory",
  "extensions": {
    "intelligent_parallel_app_factory": {
      "enabled": true,
      "engine": "midad-mobile-factory-x",
      "config": "./x/factory-x.config.json",
      "registries": [
        "./x/capabilities.registry.json",
        "./x/providers.registry.json",
        "./x/plugins.registry.json",
        "./x/agents.registry.json",
        "./x/automations.registry.json",
        "./x/selection.policy.json"
      ],
      "preflight": "./x/preflight.mjs",
      "planner": "./x/plan.mjs",
      "policy": "NEED → CAPABILITY → PROVIDER → REUSE/ADAPT/BUILD → AGENT GRAPH → PARALLEL EXECUTION → AUDIT → VERIFY",
      "agent_fabric": {
        "enabled": true,
        "protocol": "MIDAD-FX-1",
        "adapters": "./x/adapters.registry.json",
        "bindings": "./x/agent-bindings.registry.json",
        "executor": "./x/execution-fabric.mjs",
        "contract": "./x/FABRIC_PROTOCOL.md"
      }
    }
  },
  "principles": [
    "AUDIT",
    "VERIFY",
    "PRESERVE",
    "REPAIR",
    "INTEGRATE",
    "UPGRADE",
    "NEED_FIRST_PROVIDER_SECOND",
    "REUSE_BEFORE_REBUILD",
    "PARALLEL_BY_DEFAULT",
    "DISCOVER_ON_GAP",
    "LEARN_BACK_INTO_FACTORY"
  ],
  "default_pipeline": [
    "request_intake",
    "requirements_normalization",
    "factory_x_preflight",
    "capability_discovery",
    "provider_discovery_when_needed",
    "reuse_resolution",
    "product_manifest",
    "agent_graph_planning",
    "parallel_task_plan",
    "ui_content_generation",
    "static_audit",
    "dependency_audit",
    "android_build",
    "artifact_verification",
    "runtime_smoke",
    "release_package",
    "learning_capture"
  ],
  "quality": {
    "minimum_confidence": 0.9,
    "max_repair_attempts_per_incident": 3,
    "fail_closed_on_security_gate": true,
    "required_gates": [
      "manifest_valid",
      "source_present",
      "javascript_syntax",
      "security_boundary",
      "artifact_exists",
      "artifact_installability",
      "hash_recorded",
      "factory_x_preflight",
      "capability_plan",
      "provider_plan",
      "reuse_plan",
      "agent_plan",
      "automation_plan",
      "fallback_coverage",
      "source_certification",
      "contract_smoke",
      "artifact_integrity",
      "artifact_identity",
      "customer_delivery_certificate"
    ],
    "optional_gates": [
      "ui_smoke",
      "runtime_smoke",
      "accessibility",
      "localization",
      "offline_degradation",
      "performance_budget"
    ],
    "release_states": [
      "PLANNED",
      "GENERATING",
      "BUILDING",
      "TESTING",
      "VERIFIED",
      "RELEASED",
      "FAILED",
      "BLOCKED"
    ],
    "required_release_checks": [
      "source_certification",
      "contract_smoke",
      "artifact_integrity",
      "artifact_identity",
      "managed_signing_for_production",
      "customer_delivery_certificate"
    ]
  },
  "learning": {
    "enabled": true,
    "store": "supabase:midad-ai",
    "scopes": [
      "global",
      "product",
      "tenant"
    ],
    "capture": [
      "request",
      "decision",
      "tool",
      "build",
      "test",
      "failure",
      "repair",
      "release",
      "user_feedback",
      "revenue_outcome"
    ],
    "decision_policy": "evidence_weighted",
    "minimum_samples_before_global_rule": 5,
    "decay_days": 90,
    "never_learn_from": [
      "secrets",
      "private_keys",
      "passwords",
      "otp",
      "identity_documents",
      "raw_credentials"
    ],
    "future_decisions": [
      "provider_selection",
      "ui_pattern_selection",
      "feature_priority",
      "model_routing",
      "retry_strategy",
      "test_depth",
      "release_channel",
      "monetization_surface",
      "agent_allocation",
      "automation_selection",
      "build_strategy",
      "cache_strategy"
    ]
  },
  "data": {
    "primary_backend": "supabase",
    "primary_project": "midad-ai",
    "storage_layers": {
      "control_plane": "postgres",
      "artifacts": "object_storage_or_github_artifacts",
      "local_cache": "device_local",
      "secrets": "server_side_secret_store"
    },
    "tenant_isolation": [
      "tenant_key",
      "owner_user_id",
      "product_key"
    ],
    "offline_first": true,
    "sync_strategy": "outbox_then_reconcile"
  },
  "ui_generation": {
    "mode": "request_driven",
    "design_sources": [
      "product_manifest",
      "brand_profile",
      "target_market",
      "device_profile",
      "accessibility_profile"
    ],
    "required": {
      "responsive": true,
      "rtl_support": true,
      "large_touch_targets": true,
      "readable_typography": true,
      "dark_light_ready": true,
      "empty_error_loading_states": true,
      "offline_degradation": true
    },
    "dynamic_surfaces": true,
    "content_externalization": true,
    "localization": {
      "default_language": "ar",
      "supported_seed": [
        "ar",
        "en",
        "fa"
      ],
      "expand_on_demand": true
    }
  },
  "automation": {
    "n8n_optional": true,
    "need_first_provider_second": true,
    "external_send_default": "human_gate",
    "financial_action_default": "human_gate",
    "credential_entry": "never_automated",
    "parallel_independent_tasks": true,
    "dynamic_agent_pool": true,
    "provider_discovery_on_gap": true
  },
  "delivery": {
    "artifacts": [
      "apk",
      "sha256",
      "product_manifest",
      "build_report",
      "test_report",
      "learning_report",
      "factory_x_plan",
      "factory_x_preflight",
      "source_certification",
      "artifact_certification",
      "runtime_smoke",
      "customer_delivery_certificate"
    ],
    "naming": "<artifact_name>-v<version>",
    "release_channels": [
      "debug",
      "internal",
      "beta",
      "production"
    ]
  }
}
