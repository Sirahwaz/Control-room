{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIDAD Mobile Factory Product Request",
  "type": "object",
  "required": [
    "product_key",
    "display_name",
    "app_id",
    "version",
    "objective"
  ],
  "properties": {
    "product_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "target_markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "backend": {
      "type": "object"
    },
    "monetization": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
