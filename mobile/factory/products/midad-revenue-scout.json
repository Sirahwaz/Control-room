{
  "$schema": "../product.schema.json",
  "schema_version": 1,
  "product_key": "midad-revenue-scout",
  "display_name": "MIDAD Revenue Scout",
  "version": "0.1.0",
  "app_id": "ai.midad.revenue.scout",
  "artifact_name": "MIDAD-Revenue-Scout-v0.1.0",
  "web_entry": "mobile/web/index.html",
  "product_mode": "revenue-scout",
  "release_channel": "internal",
  "features": {
    "rtl_first": true,
    "local_first": true,
    "native_haptics": true,
    "native_back_navigation": true,
    "in_app_browser": true,
    "server_side_secrets_only": true,
    "live_financial_execution": false,
    "mission_capsules": true,
    "hybrid_neural_planner": true
  },
  "surfaces": [
    "revenue-forge",
    "aimidad",
    "control-room"
  ],
  "target_markets": [
    "global_remote_crypto",
    "north_america",
    "europe_uk",
    "arab_gcc",
    "arab_levant",
    "arab_north_africa",
    "east_southeast_asia",
    "south_asia",
    "latin_america"
  ],
  "monetization_models": [
    "one_time",
    "subscription",
    "white_label",
    "b2b_license",
    "lead_generation"
  ],
  "revenue_mode": "productized",
  "factory": {
    "profile": "request-driven-revenue-scout",
    "request_driven_ui": true,
    "dynamic_content": true,
    "localization": {
      "default_language": "ar",
      "supported_seed": [
        "ar",
        "en",
        "fa"
      ],
      "expand_on_demand": true
    },
    "learning": {
      "enabled": true,
      "scope": [
        "global",
        "product"
      ],
      "decision_policy": "evidence_weighted",
      "feedback_required": true
    },
    "quality": {
      "minimum_confidence": 0.9,
      "max_repair_attempts_per_incident": 3,
      "fail_closed_on_security_gate": true
    },
    "data": {
      "backend": "provider-router",
      "offline_first": true,
      "sync_strategy": "cache_then_reconcile"
    },
    "delivery": {
      "outputs": [
        "apk",
        "sha256",
        "manifest",
        "build_report",
        "test_report",
        "learning_report"
      ]
    },
    "bundle": {
      "site_files": [
        "index.html",
        "manifest.webmanifest",
        "midad-pwa-icon.svg",
        "midad-control-v2.css",
        "midad-control-v2.js",
        "midad-human-bridge-control.js",
        "iaitrader.html",
        "iaitrader.css",
        "iaitrader.js",
        "viabtc.html",
        "viabtc-neuralpp-v1.css",
        "viabtc-neuralpp-v1.js",
        "revenue-forge.html"
      ]
    }
  },
  "web_assets": [
    "mobile/web/mobile-hub.css",
    "mobile/web/mobile-hub.js",
    "mobile/web/morph-engine.js"
  ]
}
