    {"id":"factory-learning-capture","trigger":"run_complete","steps":["capture_request","capture_decisions","capture_failures","capture_repairs","capture_feedback","capture_outcome"],"parallel":["capture_decisions","capture_failures","capture_repairs"],"gate":"learning_record_saved"}
  ]
