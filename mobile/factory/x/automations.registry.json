{
  "registry_version": 1,
  "automations": [
    {"id":"factory-preflight","trigger":"before_every_build","steps":["requirements-normalize","capability-plan","provider-plan","reuse-audit","security-audit","fallback-audit"],"parallel":["capability-plan","provider-plan","reuse-audit"],"gate":"preflight_complete"},
    {"id":"provider-gap-discovery","trigger":"capability_missing","steps":["discover-providers","collect-evidence","score","register_candidate","select_primary_and_fallback"],"parallel":["discover-providers","collect-evidence"],"gate":"provider_plan_complete"},
    {"id":"parallel-static-qa","trigger":"after_source_change","steps":["js_syntax","secret_scan","dependency_audit","schema_audit","surface_wiring_audit"],"parallel":["js_syntax","secret_scan","dependency_audit","schema_audit","surface_wiring_audit"],"gate":"all_pass"},
    {"id":"rapid-build","trigger":"plan_approved","steps":["prepare_cache","incremental_build","sign_test_artifact","integrity_audit"],"parallel":["prepare_cache","incremental_build"],"gate":"artifact_verified"},
    {"id":"repair-loop","trigger":"quality_failure","steps":["classify_incident","select_repair_agent","patch","rerun_affected_checks","full_gate_if_repaired"],"max_attempts":3,"gate":"repaired_or_blocked"},
