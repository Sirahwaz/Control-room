      ],
      "outputs": [
        "capability_matches"
      ]
    },
    {
      "id": "provider-scout",
      "domain": "architecture",
      "parallel_safe": true,
      "inputs": [
        "requirements",
        "capability_matches"
      ],
      "outputs": [
        "provider_candidates"
      ]
    },
    {
      "id": "reuse-agent",
      "domain": "factory",
      "parallel_safe": true,
      "inputs": [
