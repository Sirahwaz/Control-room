{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIDAD Mobile Factory Product",
  "type": "object",
  "required": [
    "schema_version",
    "product_key",
    "display_name",
    "version",
    "app_id",
    "artifact_name",
    "web_entry",
    "product_mode",
    "release_channel",
    "features",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "product_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
    },
    "artifact_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"
    },
    "web_entry": {
      "type": "string",
      "minLength": 1
    },
    "product_mode": {
      "type": "string",
      "minLength": 1
    },
    "release_channel": {
      "type": "string",
      "enum": [
        "debug",
        "internal",
        "beta",
        "production"
      ]
    },
    "features": {
      "type": "object",
      "required": [
        "rtl_first",
        "local_first",
        "native_haptics",
        "native_back_navigation",
        "in_app_browser",
        "server_side_secrets_only",
        "live_financial_execution",
        "mission_capsules",
        "hybrid_neural_planner"
      ],
      "properties": {
        "rtl_first": {
          "type": "boolean"
        },
        "local_first": {
          "type": "boolean"
        },
        "native_haptics": {
          "type": "boolean"
        },
        "native_back_navigation": {
          "type": "boolean"
        },
        "in_app_browser": {
          "type": "boolean"
        },
        "server_side_secrets_only": {
          "type": "boolean"
        },
        "live_financial_execution": {
          "type": "boolean"
        },
        "mission_capsules": {
          "type": "boolean"
        },
        "hybrid_neural_planner": {
          "type": "boolean"
        },
        "human_bridge": {
          "type": "boolean"
        },
        "agentic_browser": {
          "type": "boolean"
        },
        "safe_autofill": {
          "type": "boolean"
        },
        "local_notifications": {
          "type": "boolean"
        },
        "secure_pairing": {
          "type": "boolean"
        },
        "native_agent_engine": {
          "type": "boolean"
        },
        "multimodal_reasoning": {
          "type": "boolean"
        },
        "phone_files": {
          "type": "boolean"
        },
        "media_studio": {
          "type": "boolean"
        },
        "automation_recipes": {
          "type": "boolean"
        },
        "extension_fabric": {
          "type": "boolean"
        },
        "provider_router": {
          "type": "boolean"
        },
        "gemini_gateway": {
          "type": "boolean"
        },
        "gemini_notebook_bridge": {
          "type": "boolean"
        },
        "offline_operator": {
          "type": "boolean"
        },
        "event_bus": {
          "type": "boolean"
        },
        "trust_boundary_ui": {
          "type": "boolean"
        },
        "proactive_execution": {
          "type": "boolean"
        },
        "adaptive_recovery": {
          "type": "boolean"
        },
        "evidence_capture": {
          "type": "boolean"
        },
        "mission_autoflow": {
          "type": "boolean"
        },
        "camera_input": {
          "type": "boolean"
        },
        "smart_inspector": {
          "type": "boolean"
        },
        "communication_agent": {
          "type": "boolean"
        },
        "multilingual_composer": {
          "type": "boolean"
        },
        "live_voice_translation": {
          "type": "boolean"
        },
        "voice_reply": {
          "type": "boolean"
        },
        "communication_memory": {
          "type": "boolean"
        },
        "send_requires_human_gate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "target_markets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "monetization_models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "revenue_mode": {
      "type": "string",
      "enum": [
        "internal",
        "productized",
        "b2b",
        "consumer",
        "white_label"
      ]
    },
    "factory": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string"
        },
        "request_driven_ui": {
          "type": "boolean"
        },
        "dynamic_content": {
          "type": "boolean"
        },
        "localization": {
          "type": "object"
        },
        "learning": {
          "type": "object"
        },
        "quality": {
          "type": "object"
        },
        "data": {
          "type": "object"
        },
        "delivery": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
