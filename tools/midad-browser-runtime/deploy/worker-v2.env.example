# Copy to /etc/midad-browser/worker.env and set owner=midad-browser, mode=0600.
# Replace every placeholder with verified values; never commit the filled file.
# The worker has no admin key. Enroll the node separately and use the private token file.

MIDAD_CONTINUITY_LEDGER_URL=https://REPLACE-WITH-DEPLOYED-CLOUDFLARE-WORKER.workers.dev
MIDAD_CONTINUITY_NODE_ID=midad-browser-node-01
MIDAD_CONTINUITY_NODE_TOKEN_FILE=/etc/midad-browser/node-token
MIDAD_CONTINUITY_OWNER_ID=REPLACE-WITH-OWNER-UUID

# Exact host allowlist only. Never use wildcards.
MIDAD_BROWSER_ALLOWED_HOSTS=example.com

# Must exactly match the capabilities explicitly approved at node enrollment.
MIDAD_CONTINUITY_ENROLLED_CAPABILITIES=interactive-browser-execution,persistent-browser-session,encrypted-session-store

# Do not change to true until the actual host cost has been measured and approved.
MIDAD_CONTINUITY_COST_ESTIMATE_VERIFIED=false
MIDAD_CONTINUITY_COST_PER_HOUR_USD=REPLACE-WITH-VERIFIED-USD-COST

MIDAD_BROWSER_ACCOUNT_REGISTRY=/etc/midad-browser/accounts.json
MIDAD_BROWSER_SESSION_STORE_DIR=/var/lib/midad-browser/sessions

# Generate a 32-byte random key privately (for example: openssl rand -base64 32).
# Do not place a real key in this template, Git, chat, issue comments or APK assets.
MIDAD_BROWSER_SESSION_MASTER_KEY_B64=SET_IN_PRIVATE_HOST_SECRET_STORE

MIDAD_CONTINUITY_POLL_SECONDS=3
MIDAD_CONTINUITY_HEARTBEAT_SECONDS=15

# The following aliases are referenced by accounts.json. Inject their actual values
# from the host's approved secret store into the worker process, never into Git.
# MIDAD_EXAMPLE_PASSWORD=INJECT_FROM_PRIVATE_SECRET_MANAGER
