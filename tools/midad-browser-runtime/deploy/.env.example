# Template only. Configure actual values in your hosting provider's private environment UI.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MIDAD_INGEST_KEY=SET_IN_PRIVATE_HOST_ENVIRONMENT
MIDAD_BROWSER_ALLOWED_HOSTS=example.com
MIDAD_OPERATOR_OWNER_USER_ID=YOUR_AUTHORIZED_USER_UUID
MIDAD_BROWSER_ACCOUNT_REGISTRY=/home/container/midad-operator-worker/accounts.json
MIDAD_OPERATOR_POLL_SECONDS=3

# Define each MIDAD_*_PASSWORD alias in the host's secret manager/environment.
# Do not add actual passwords, cookies, MFA codes, or tokens to this file.
MIDAD_EXAMPLE_COM_PASSWORD=SET_IN_PRIVATE_HOST_SECRET_STORE
