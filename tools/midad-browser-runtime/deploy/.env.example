# Template only. Configure actual values in your hosting provider's private environment UI.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MIDAD_INGEST_KEY=SET_IN_PRIVATE_HOST_ENVIRONMENT
MIDAD_BROWSER_ALLOWED_HOSTS=example.com
# Optional: if omitted, the worker resolves the single configured owner profile through the private gateway.
# MIDAD_OPERATOR_OWNER_USER_ID=YOUR_AUTHORIZED_USER_UUID
MIDAD_BROWSER_ACCOUNT_REGISTRY=/home/container/midad-operator-worker/accounts.json
MIDAD_OPERATOR_POLL_SECONDS=3

# Define each MIDAD_*_PASSWORD alias in the host's secret manager/environment.
# Do not add actual passwords, cookies, MFA codes, or tokens to this file.
MIDAD_EXAMPLE_COM_PASSWORD=SET_IN_PRIVATE_HOST_SECRET_STORE

# Optional, fail-closed Proxy routing. Omit until a private config file is installed.
MIDAD_NETWORK_ACCESS_CONFIG=/var/lib/midad-browser/network-access.json
# Reference-to-alias map only; actual JSON credentials belong in the host secret manager.
MIDAD_VAULT_BINDINGS_JSON={"vault://proxy/eu-01/auth":"MIDAD_PROXY_EU01_AUTH"}
# Configure this value as a JSON object in the host secret manager, never in this file:
# {"username":"...","password":"..."}
MIDAD_PROXY_EU01_AUTH=SET_IN_PRIVATE_HOST_SECRET_STORE
