            "contents:write",
            "pull-requests:write",
            "id-token:write"
          ]
        }
      },
      "runner_adapter": {
        "provider": "github-actions-linux",
        "workflow": ".github/workflows/midad-forge.yml",
        "job": "build",
        "node_version": 24,
        "job_timeout_minutes": 15,
        "persistent": false,
        "permissions": {
          "contents": "read",
          "checkout_credentials_persisted": false,
          "id_token_permission": false,
          "pull_request_write_permission": false
        }
      },
      "execution_policy": {
        "max_manifest_files": 32,
        "max_source_file_bytes": 60000,
        "max_manifest_bytes": 2000000,
        "allowed_npm_scripts": [
          "lint",
          "test",
          "build"
        ],
        "npm_lifecycle_scripts": "disabled",
        "install_flags": [
          "--ignore-scripts",
          "--no-audit",
          "--no-fund"
        ],
        "command_timeout_seconds": 180,
        "output_log_limit_bytes": 512000,
        "max_artifact_files": 3000,
        "max_artifact_file_bytes": 5000000,
        "max_artifact_bytes": 30000000,
        "reject_path_traversal": true,
        "reject_symlinks": true,
        "reject_credentials_and_private_key_files": true,
        "child_process_environment": "minimal-no-github-or-supabase-secrets",
        "network_egress": "not_isolated_in_this_iteration"
      },
      "capacity_boundary": {
        "persistent_host": "optional_specialist_node_not_provisioned",
        "production_online_service": "serverless_control_plane_plus_ephemeral_workers_pending_live_dispatch_verification",
        "do_not_infer_persistence_from_github_actions": true
      }
    },
    "hakios_lab": {
      "role": "isolated_research_guest",
      "production_kernel": false,
      "source_repository": "oosexgang/hakios-xnu-kernel",
      "source_ref": "63fc2b4633bac3af8e57dadab9f5a8d4cb940438",
      "qemu": {
        "target": "qemu-open",
        "smoke_mode": "prebuilt-qemu-boot",
        "full_source_build": false,
        "requires_apple_payload": false,
        "network_exposure": "none_by_default",
        "purpose": "kernel-build-and-boot-research",
        "artifact_integrity_check": "grep prebuilt entries from prebuilt/SHA256SUMS and verify with sha256sum",
        "ci_workflow": ".github/workflows/midad-hakios-qemu-smoke.yml",
        "boot_path_strategy": "parallel-differential-plus-uboot",
        "boot_paths": [
          "loader-device",
          "uefi-esp",
          "u-boot"
        ],
        "diagnostic_qemu_flags": [
          "guest_errors",
          "cpu_reset"
        ],
        "firmware_pairing_strategy": "use-matched-aavmf-code-and-vars-images-with-equal-size-no-padding",
        "uboot_path": {
          "firmware": "U-Boot v2026.07 with HakiOS patch",
          "build_command": "uefi/u-boot/build.sh qemu",
          "runner": "qemu/run-u-boot.sh",
          "payload_transport": "HKUB container at 0x50000000; payload at 0xF0000000",
          "source_repository": "oosexgang/hakios-uefi",
          "source_revision": "1c6522893266157506c767e2ca427053ed3634a8",
          "requires_edk2": false,
          "research_only": true,
          "boot_command_override": {
            "upstream": "hakios load 0x50000000 && run hakios_start",
            "ci_override": "hakios load 0x50000000 && hakios boot",
            "reason": "The pinned defconfig references hakios_start, but no environment variable defines it; the pinned U-Boot patch implements an explicit hakios boot subcommand.",
            "scope": "MIDAD CI-only patch to the ephemeral HakiOS checkout; upstream repository remains unchanged."
          }
        },
        "boot_path_results": {
          "u-boot": {
            "status": "verified",
            "result": "loader-kernel-userland-and-return-to-loader",
            "run_id": 42312414610,
            "job_id": 128216829054,
            "evidence": [
              "== XNULOADER v3 ==",
              "platform qemu-virt",
              "Hello from user space on Darwin!",
              "kernel returned: log at",
              "returned 21713 0"
            ],
            "termination": {
              "observed": "PID 1 (launchd test payload) exits with status 0; XNU records initproc-failed panic; XNULOADER captures and returns the kernel log.",
              "classification": "expected_one_shot_research_payload_exit_not_a_stable_os_session"
            },
            "stable_os_session_verified": false,
            "full_source_build_verified": false
          },
          "uefi-esp": {
            "status": "failed-before-loader",
            "exception": "Synchronous Exception at 0x00000000A10021A8",
            "run_id": 42311648171
          },
          "loader-device": {
            "status": "failed-before-loader",
            "exception": "Synchronous Exception at 0x00000000A10021A8",
            "run_id": 42311648171
          }
        }
      }
    }
  },
