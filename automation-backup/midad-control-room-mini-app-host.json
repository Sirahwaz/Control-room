          "responseBody": "<!doctype html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#050914\">\n<script src=\"https://telegram.org/js/telegram-web-app.js?63\"></script>\n<title>MIDAD — Intelligence Control Room</title>\n<style>\n:root{--bg:#050914;--panel:rgba(12,20,38,.82);--panel2:rgba(18,29,52,.72);--line:rgba(135,170,255,.14);--text:#edf5ff;--muted:#8190ad;--cyan:#27d9ff;--violet:#9a7cff;--green:#35e6a1;--amber:#ffc857;--red:#ff5574;--shadow:0 18px 60px rgba(0,0,0,.38)}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(circle at 80% 0%,rgba(39,217,255,.12),transparent 30%),radial-gradient(circle at 10% 20%,rgba(154,124,255,.12),transparent 28%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Arial,sans-serif}\nbody:before{content:\"\";position:fixed;inset:0;pointer-events:none;background:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,black,transparent 85%)}\n.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.side{position:sticky;top:0;height:100vh;padding:20px 16px;border-left:1px solid var(--line);background:rgba(4,8,18,.78);backdrop-filter:blur(22px);z-index:5}.brand{display:flex;gap:12px;align-items:center;margin-bottom:22px}.logo{width:44px;height:44px;border-radius:14px;background:conic-gradient(from 180deg,var(--cyan),var(--violet),var(--green),var(--cyan));box-shadow:0 0 28px rgba(39,217,255,.25);display:grid;place-items:center;color:#06101d;font-weight:900}.brand b{font-size:18px}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.nav{display:grid;gap:7px}.nav button{border:1px solid transparent;background:transparent;color:#b9c6dc;text-align:right;padding:11px 12px;border-radius:12px;font-size:13px;cursor:pointer;transition:.2s}.nav button:hover,.nav button.active{background:linear-gradient(90deg,rgba(39,217,255,.12),rgba(154,124,255,.08));border-color:var(--line);color:#fff}.nav span{display:inline-block;width:25px}.sidefoot{position:absolute;bottom:18px;left:16px;right:16px;padding:12px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.025);font-size:11px;color:var(--muted)}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);margin-left:6px}\nmain{padding:20px;max-width:1500px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px}.eyebrow{font-size:11px;color:var(--cyan);letter-spacing:.12em;text-transform:uppercase}.top h1{margin:4px 0;font-size:27px}.sub{color:var(--muted);font-size:12px}.actions{display:flex;gap:8px}.btn{border:1px solid var(--line);background:var(--panel);color:#fff;padding:10px 13px;border-radius:11px;cursor:pointer}.btn.primary{background:linear-gradient(135deg,rgba(39,217,255,.2),rgba(154,124,255,.22));border-color:rgba(39,217,255,.35)}\n.kpis{display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:10px}.kpi{position:relative;overflow:hidden;padding:15px;border:1px solid var(--line);border-radius:16px;background:var(--panel);box-shadow:var(--shadow)}.kpi:after{content:\"\";position:absolute;width:80px;height:80px;border-radius:50%;background:var(--glow);filter:blur(30px);left:-35px;bottom:-45px;opacity:.35}.kpi .label{color:var(--muted);font-size:11px}.kpi .num{font-size:25px;font-weight:800;margin:7px 0 2px}.cyan{color:var(--cyan)}.green{color:var(--green)}.amber{color:var(--amber)}.violet{color:var(--violet)}.red{color:var(--red)}\n.grid{display:grid;grid-template-columns:1.45fr .9fr;gap:12px;margin-top:12px}.panel{border:1px solid var(--line);border-radius:18px;background:var(--panel);box-shadow:var(--shadow);padding:16px;overflow:hidden}.panelhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.panelhead h2{font-size:15px;margin:0}.panelhead small{color:var(--muted);font-size:10px}.screen{height:235px;position:relative;border:1px solid rgba(39,217,255,.13);border-radius:15px;background:linear-gradient(180deg,rgba(7,18,35,.9),rgba(4,9,18,.9));overflow:hidden}.screen:before{content:\"\";position:absolute;inset:0;background:linear-gradient(transparent 49%,rgba(39,217,255,.055) 50%,transparent 51%);background-size:100% 8px;opacity:.55}.bars{position:absolute;inset:25px 20px 35px;display:flex;align-items:end;gap:8px}.bar{flex:1;border-radius:6px 6px 2px 2px;background:linear-gradient(180deg,var(--cyan),rgba(39,217,255,.05));box-shadow:0 0 15px rgba(39,217,255,.12);min-height:8px}.chartline{position:absolute;inset:45px 25px 35px}.chartline svg{width:100%;height:100%}.screenmeta{position:absolute;top:13px;right:14px;left:14px;display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}.feed{display:grid;gap:9px}.feedrow{display:grid;grid-template-columns:10px 1fr auto;gap:9px;align-items:center;padding:11px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025)}.dot{width:8px;height:8px;border-radius:50%}.feedrow b{font-size:12px}.feedrow small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.score{font-weight:800;font-size:13px}.centers{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px}.center{padding:15px;border-radius:16px;border:1px solid var(--line);background:var(--panel2);cursor:pointer;transition:.2s}.center:hover{transform:translateY(-2px);border-color:rgba(39,217,255,.35)}.center .ico{font-size:21px}.center b{display:block;margin-top:9px;font-size:13px}.center small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.section{display:none}.section.show{display:block}.table{width:100%;border-collapse:collapse;font-size:11px}.table th,.table td{padding:11px;border-bottom:1px solid var(--line);text-align:right}.table th{color:var(--muted);font-weight:500}.tag{display:inline-flex;padding:4px 7px;border-radius:7px;background:rgba(53,230,161,.09);color:var(--green);font-size:9px}.wallets{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.wallet{padding:14px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.025)}.wallet .addr{font-family:monospace;color:#aab8d1;font-size:10px;direction:ltr;text-align:left}.wallet .balance{font-size:20px;font-weight:800;margin:8px 0}.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px;z-index:20}.modal.open{display:flex}.modalbox{width:min(480px,100%);padding:20px;border:1px solid var(--line);border-radius:20px;background:#0a1222}.input{width:100%;padding:12px;margin:8px 0;background:#060b15;border:1px solid var(--line);border-radius:10px;color:#fff;outline:none}.note{color:var(--muted);font-size:10px;line-height:1.6}.safe{padding:10px;border:1px solid rgba(53,230,161,.2);background:rgba(53,230,161,.05);border-radius:10px;color:#aeeed4;font-size:10px;margin-top:10px}\n@media(max-width:1050px){.kpis{grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:1fr}.centers{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.app{display:block}.side{position:fixed;bottom:0;top:auto;right:0;left:0;width:100%;height:auto;padding:8px 10px;border-left:0;border-top:1px solid var(--line)}.brand,.sidefoot{display:none}.nav{display:flex;overflow:auto}.nav button{min-width:58px;text-align:center;font-size:9px;padding:8px 6px}.nav span{display:block;width:auto;font-size:17px;margin-bottom:2px}main{padding:14px 12px 82px}.top h1{font-size:22px}.actions .btn:first-child{display:none}.kpis{grid-template-columns:repeat(2,1fr)}.centers{grid-template-columns:repeat(2,1fr)}.wallets{grid-template-columns:1fr}.screen{height:200px}}\n</style>\n</head>\n<body>\n<div class=\"app\">\n<aside class=\"side\">\n  <div class=\"brand\"><div class=\"logo\">M</div><div><b>مِداد AI</b><small>INTELLIGENCE ORCHESTRATOR</small></div></div>\n  <div class=\"nav\">\n    <button class=\"active\" onclick=\"show('dash',this)\"><span>◈</span>الرئيسية</button>\n    <button onclick=\"show('opp',this)\"><span>🎯</span>الفرص</button>\n    <button onclick=\"show('trade',this)\"><span>◫</span>التداول</button>\n    <button onclick=\"show('wallet',this)\"><span>◉</span>المحافظ</button>\n    <button onclick=\"show('mine',this)\"><span>⛏</span>التعدين</button>\n    <button onclick=\"show('auto',this)\"><span>⚙</span>الأتمتة</button>\n    <button onclick=\"show('learn',this)\"><span>◎</span>التعلّم</button>\n  </div>\n  <div class=\"sidefoot\"><span class=\"pulse\"></span>واجهة التحكم جاهزة · Safe Mode</div>\n</aside>\n<main>\n<section id=\"dash\" class=\"section show\">\n  <div class=\"top\"><div><div class=\"eyebrow\">MIDAD / CONTROL ROOM</div><h1>مركز القيادة الذكي</h1><div class=\"sub\">لوحة رقمية موحّدة للفرص، الأسواق، المحافظ، التعدين والأتمتة</div></div><div class=\"actions\"><button class=\"btn\" onclick=\"sync()\">↻ مزامنة</button><button class=\"btn primary\" onclick=\"telegram('افتح مركز مِداد واعرض الحالة الحالية')\">فتح التحكم في Telegram</button></div></div>\n  <div class=\"kpis\">\n    <div class=\"kpi\" style=\"--glow:var(--cyan)\"><div class=\"label\">الفرص النشطة</div><div class=\"num cyan\">—</div><div class=\"label\">بانتظار مصدر البيانات</div></div>\n    <div class=\"kpi\" style=\"--glow:var(--green)\"><div class=\"label\">عالية الأولوية</div><div class=\"num green\">—</div><div class=\"label\">High / Critical</div></div>\n    <div class=\"kpi\" style=\"--glow:var(--violet)\"><div class=\"label\">إشارات السوق</div><div class=\"num violet\">—</div><div class=\"label\">Radar / Assets</div></div>\n    <div class=\"kpi\" style=\"--glow:var(--amber)\"><div class=\"label\">المحافظ</div><div class=\"num amber\">0</div><div class=\"label\">قراءة عامة فقط</div></div>\n    <div class=\"kpi\" style=\"--glow:var(--green)\"><div class=\"label\">التعدين</div><div class=\"num green\">140 TH/s</div><div class=\"label\">M31+M21 · ViaBTC</div></div>\n    <div class=\"kpi\" style=\"--glow:var(--cyan)\"><div class=\"label\">صحة النظام</div><div class=\"num cyan\">OK</div><div class=\"label\">Control Layer</div></div>\n  </div>\n  <div class=\"grid\">\n    <div class=\"panel\"><div class=\"panelhead\"><h2>📡 شاشة الذكاء اللحظي</h2><small>Digital Signal Monitor</small></div><div class=\"screen\"><div class=\"screenmeta\"><span>LIVE MATRIX</span><span>SAFE / READ-ONLY</span></div><div class=\"bars\"><i class=\"bar\" style=\"height:34%\"></i><i class=\"bar\" style=\"height:58%\"></i><i class=\"bar\" style=\"height:43%\"></i><i class=\"bar\" style=\"height:72%\"></i><i class=\"bar\" style=\"height:49%\"></i><i class=\"bar\" style=\"height:86%\"></i><i class=\"bar\" style=\"height:62%\"></i><i class=\"bar\" style=\"height:78%\"></i><i class=\"bar\" style=\"height:54%\"></i><i class=\"bar\" style=\"height:92%\"></i><i class=\"bar\" style=\"height:67%\"></i><i class=\"bar\" style=\"height:75%\"></i><i class=\"bar\" style=\"height:48%\"></i><i class=\"bar\" style=\"height:82%\"></i><i class=\"bar\" style=\"height:60%\"></i></div><div class=\"chartline\"><svg viewBox=\"0 0 600 170\" preserveAspectRatio=\"none\"><polyline fill=\"none\" stroke=\"#9a7cff\" stroke-width=\"3\" points=\"0,140 45,128 90,135 135,88 180,102 225,58 270,74 315,42 360,66 405,32 450,55 495,24 540,48 600,18\"/></svg></div></div></div>\n    <div class=\"panel\"><div class=\"panelhead\"><h2>⚡ آخر النشاط</h2><small>System Feed</small></div><div class=\"feed\">\n      <div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--cyan)\"></i><div><b>Opportunity Mesh</b><small>الرادار جاهز لاستقبال الإشارات</small></div><span class=\"score cyan\">READY</span></div>\n      <div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--green)\"></i><div><b>ViaBTC Monitor</b><small>140 TH/s · قناة التعدين</small></div><span class=\"score green\">ON</span></div>\n      <div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--violet)\"></i><div><b>Learning Engine</b><small>حلقة القياس والتحسين</small></div><span class=\"score violet\">ON</span></div>\n      <div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--amber)\"></i><div><b>Trading Center</b><small>التنفيذ المباشر معطّل</small></div><span class=\"score amber\">SAFE</span></div>\n    </div></div>\n  </div>\n  <div class=\"centers\">\n    <div class=\"center\" onclick=\"show('opp')\"><div class=\"ico\">🎯</div><b>Opportunity Center</b><small>فرص · تقييم · مخاطرة · ROI</small></div>\n    <div class=\"center\" onclick=\"show('trade')\"><div class=\"ico\">◫</div><b>Trading Center</b><small>أسواق · Watchlist · Paper Mode</small></div>\n    <div class=\"center\" onclick=\"show('wallet')\"><div class=\"ico\">◉</div><b>Wallet Center</b><small>إضافة ومراقبة عناوين عامة</small></div>\n    <div class=\"center\" onclick=\"show('auto')\"><div class=\"ico\">⚙</div><b>Automation Center</b><small>n8n · Routes · Health</small></div>\n  </div>\n</section>\n\n<section id=\"opp\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">OPPORTUNITY INTELLIGENCE</div><h1>مركز الفرص</h1><div class=\"sub\">تجميع الإشارات قبل القرار، مع فصل الدليل عن التقييم</div></div><button class=\"btn primary\" onclick=\"telegram('اعرض الفرص عالية الأولوية')\">إرسال إلى مِداد</button></div><div class=\"panel\"><table class=\"table\"><thead><tr><th>الفرصة</th><th>الحالة</th><th>الثقة</th><th>المخاطرة</th><th>الإجراء</th></tr></thead><tbody><tr><td>بانتظار تدفق Opportunity Mesh</td><td><span class=\"tag\">WATCH</span></td><td>—</td><td>—</td><td>تفاصيل</td></tr><tr><td>New Assets Radar</td><td><span class=\"tag\">READY</span></td><td>—</td><td>—</td><td>فتح الرادار</td></tr></tbody></table></div></section>\n\n<section id=\"trade\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">MARKET OPERATIONS</div><h1>مركز التداول</h1><div class=\"sub\">مراقبة وتحليل أولاً · التنفيذ المالي المباشر غير مفعّل</div></div><button class=\"btn\" onclick=\"telegram('اعرض حالة التداول الآمن')\">حالة التداول</button></div><div class=\"grid\"><div class=\"panel\"><div class=\"panelhead\"><h2>السوق / Watchlist</h2><small>Paper / Read-only</small></div><div class=\"screen\"><div class=\"screenmeta\"><span>MARKET MATRIX</span><span>NO EXECUTION</span></div><div class=\"chartline\"><svg viewBox=\"0 0 600 170\" preserveAspectRatio=\"none\"><polyline fill=\"none\" stroke=\"#35e6a1\" stroke-width=\"3\" points=\"0,125 40,132 85,104 130,116 170,80 215,96 255,62 300,74 340,44 385,57 425,38 470,62 515,35 560,49 600,22\"/></svg></div></div></div><div class=\"panel\"><h2>ضوابط المخاطر</h2><p class=\"note\">لا مفاتيح خاصة، لا seed phrases، لا تجاوز KYC/CAPTCHA، ولا تنفيذ تلقائي. أي تنفيذ مالي مستقبلي يحتاج مسار موافقة مستقل.</p><div class=\"safe\">✓ Safe Mode مفعل · التحليل والمراقبة فقط</div></div></div></section>\n\n<section id=\"wallet\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">WALLET INTELLIGENCE</div><h1>مركز المحافظ</h1><div class=\"sub\">تتبع عناوين عامة فقط — لا تخزين لمفاتيح خاصة</div></div><button class=\"btn primary\" onclick=\"openModal()\">＋ إضافة Wallet</button></div><div class=\"wallets\"><div class=\"wallet\"><div>BTC · Watchlist</div><div class=\"balance\">—</div><div class=\"addr\">لم تتم إضافة عناوين</div></div><div class=\"wallet\"><div>EVM · Watchlist</div><div class=\"balance\">—</div><div class=\"addr\">لم تتم إضافة عناوين</div></div><div class=\"wallet\"><div>Signals</div><div class=\"balance\">—</div><div class=\"addr\">جاهز للربط مع Radar</div></div></div><div class=\"panel\" style=\"margin-top:12px\"><p class=\"note\">الإضافة هنا مخصصة للعناوين العامة وLabels فقط. لا تدخل private key أو seed phrase في غرفة التحكم.</p></div></section>\n\n<section id=\"mine\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">MINING CAPITAL</div><h1>مركز التعدين</h1><div class=\"sub\">ViaBTC · مصدر رأس المال التشغيلي</div></div><button class=\"btn\" onclick=\"telegram('اعرض حالة التعدين ViaBTC')\">حالة ViaBTC</button></div><div class=\"kpis\"><div class=\"kpi\"><div class=\"label\">Hashrate</div><div class=\"num green\">140 TH/s</div></div><div class=\"kpi\"><div class=\"label\">M31+</div><div class=\"num cyan\">84 TH/s</div></div><div class=\"kpi\"><div class=\"label\">M21</div><div class=\"num violet\">56 TH/s</div></div></div><div class=\"panel\" style=\"margin-top:12px\"><p class=\"note\">يتم فصل مراقبة التعدين عن قرارات الفرص والتداول، مع إمكانية استخدام صافي العائد كمصدر تمويل في طبقة Opportunity Intelligence.</p></div></section>\n\n<section id=\"auto\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">AUTOMATION FABRIC</div><h1>مركز الأتمتة</h1><div class=\"sub\">n8n · Orchestrator · Telegram · Supabase · Learning</div></div><button class=\"btn\" onclick=\"telegram('اعرض صحة أتمتة مِداد')\">فحص الأتمتة</button></div><div class=\"centers\"><div class=\"center\"><div class=\"ico\">🧠</div><b>Orchestrator v3</b><small>Active</small></div><div class=\"center\"><div class=\"ico\">📡</div><b>Signal Radar</b><small>Active</small></div><div class=\"center\"><div class=\"ico\">🎯</div><b>Opportunity Mesh</b><small>Active</small></div><div class=\"center\"><div class=\"ico\">🧬</div><b>Learning Engine</b><small>Active</small></div></div></section>\n\n<section id=\"learn\" class=\"section\"><div class=\"top\"><div><div class=\"eyebrow\">LEARNING LOOP</div><h1>مركز التعلّم</h1><div class=\"sub\">Outcome → Evaluation → Improvement</div></div><button class=\"btn\" onclick=\"telegram('اعرض آخر نتائج التعلم')\">نتائج التعلم</button></div><div class=\"panel\"><div class=\"feed\"><div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--violet)\"></i><div><b>Decision Fabric</b><small>يفصل القرار عن المصدر ويحافظ على قابلية النقل</small></div><span class=\"score violet\">READY</span></div><div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--green)\"></i><div><b>Outcome Measurement</b><small>قياس النتيجة قبل تعديل السلوك</small></div><span class=\"score green\">ON</span></div><div class=\"feedrow\"><i class=\"dot\" style=\"background:var(--cyan)\"></i><div><b>Change Gate</b><small>التغييرات الحساسة تحتاج تحققاً قبل النشر</small></div><span class=\"score cyan\">SAFE</span></div></div></div></section>\n</main>\n</div>\n\n<div id=\"modal\" class=\"modal\"><div class=\"modalbox\"><div class=\"panelhead\"><h2>إضافة محفظة للمراقبة</h2><button class=\"btn\" onclick=\"closeModal()\">×</button></div><input id=\"chain\" class=\"input\" placeholder=\"الشبكة: BTC / EVM / ...\"><input id=\"address\" class=\"input\" placeholder=\"العنوان العام فقط\"><input id=\"label\" class=\"input\" placeholder=\"اسم المحفظة / Label\"><div class=\"safe\">✓ لن يتم قبول private key أو seed phrase.</div><button class=\"btn primary\" style=\"width:100%;margin-top:12px\" onclick=\"addWallet()\">إضافة للمراقبة</button></div></div>\n\n<script>\nconst tg=window.Telegram?.WebApp;if(tg){tg.ready();tg.expand();}\nfunction show(id,el){document.querySelectorAll('.section').forEach(x=>x.classList.remove('show'));document.getElementById(id).classList.add('show');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active');else{const b=[...document.querySelectorAll('.nav button')].find(x=>x.getAttribute('onclick')?.includes(\"'\"+id+\"'\"));if(b)b.classList.add('active')}window.scrollTo({top:0,behavior:'smooth'});}\nfunction telegram(command){if(tg){tg.sendData(JSON.stringify({command}));}else{navigator.clipboard?.writeText(command);alert(command)}}\nfunction sync(){const b=document.querySelector('.eyebrow');b.textContent='MIDAD / SYNC REQUESTED';setTimeout(()=>b.textContent='MIDAD / CONTROL ROOM',900);telegram('/status')}\nfunction openModal(){document.getElementById('modal').classList.add('open')}\nfunction closeModal(){document.getElementById('modal').classList.remove('open')}\nfunction addWallet(){const a=document.getElementById('address').value.trim();if(!a){alert('أدخل عنواناً عاماً');return}if(/seed|private|mnemonic|secret/i.test(a)){alert('مرفوض: مفاتيح أو seed phrases غير مسموحة');return}closeModal();alert('تم تجهيز العنوان للمراقبة. الربط مع مخزن المحافظ سيُنفذ عبر طبقة البيانات الآمنة.')}\n</script>\n</body></html>",
