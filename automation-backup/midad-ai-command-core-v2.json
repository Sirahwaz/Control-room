      {
        "id": "ab51759d-0e44-44a0-8837-36443de40ffe",
        "name": "MIDAD AI — Intent Router",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const input=$input.first().json||{};const command=String(input.command||'').trim();const s=command.toLowerCase();let intent='general';if(/(تقييم ذكاء|تقييم النموذج|evaluate|evaluation|benchmark|مرجع|reference model|probability fidelity|اختبار الذكاء)/i.test(s))intent='evaluation';else if(/(freelance|فريلانس|فريلانسر|مشروع حر|مشاريع حرة|عميل|proposal|عرض عمل|gig)/i.test(s))intent='freelance';else if(/(فرص|opportunit|revenue|دخل|أرباح|airdrops?|إيردروب)/i.test(s))intent='opportunities';else if(/(رادار|signal|إشارة|market|سوق|asset|أصل)/i.test(s))intent='intelligence';else if(/(تعلم|learning|outcome|نتائج|أداء الإشارات)/i.test(s))intent='learning';else if(/(تعدين|mining|viabtc|hashrate|worker)/i.test(s))intent='mining';else if(/(تداول|trade|paper|أمر|order)/i.test(s))intent='trading_safe';else if(/(أتمة|automation|workflow|workflows|تشغيل)/i.test(s))intent='automation';else if(/(سلوك|graph|رسم|wallet|محفظة|address|عنوان)/i.test(s))intent='behavior';return [{json:{...input,command,intent,router_note:'Intent classification only; no external action is executed by this router.'}}];"
        }
      },
